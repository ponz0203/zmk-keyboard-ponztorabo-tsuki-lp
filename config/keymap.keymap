#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <3>;
        };
    };

    behaviors {
        new_behavior: new_behavior {
            compatible = "zmk,behavior-input-two-axis";
            label = "NEW_BEHAVIOR";
            #binding-cells = <1>;
            x-input-code = <9>;
            y-input-code = <8>;
            trigger-period-ms = <16>;
            time-to-max-speed-ms = <300>;
            acceleration-exponent = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&trans  &trans      &trans    &trans    &trans                     &trans                                                     &trans       &trans  &trans     &trans           &trans       &trans
&trans  &kp Q       &kp W     &kp E     &kp R                      &kp T                                                      &kp Y        &kp U   &kp I      &kp O            &kp P        &trans
&trans  &kp A       &kp S     &kp D     &kp F                      &kp G                 &trans                   &trans      &kp H        &kp J   &kp K      &kp L            &lt 3 ENTER  &trans
&trans  &kp Z       &kp X     &kp C     &kp V                      &kp B                 &mt LEFT_SHIFT UP_ARROW  &lt 5 TAB   &kp N        &kp M   &kp COMMA  &kp DOT          &lt 4 MINUS  &trans
&trans  &kp ESCAPE  &kp LGUI  &kp LALT  &mt LANGUAGE_1 LANGUAGE_2  &mt LEFT_SHIFT SPACE  &mt LEFT_CONTROL DOWN    &lt 2 LEFT  &lt 1 RIGHT  &trans  &trans     &kp PRINTSCREEN  &kp ESCAPE   &trans
            >;
        };

        NUMBER {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans               &trans        &trans        &trans        &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &none                &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp DELETE     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mt SEMICOLON COLON  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp BACKSPACE  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp EQUAL  &kp NUMBER_0         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp RC(A)      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans               &trans        &trans        &kp COMMA     &kp PERIOD     &trans
            >;
        };

        SYMBOL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                             &trans                               &trans         &trans                    &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &none                              &none                                &none          &kp AT_SIGN               &kp AT_SIGN    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mt LEFT_BRACKET LEFT_PARENTHESIS  &mt RIGHT_BRACKET RIGHT_PARENTHESIS  &kp SEMICOLON  &kp COLON                 &kp BACKSPACE  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SINGLE_QUOTE                   &kp DQT                              &kp GRAVE      &mt EXCLAMATION QUESTION  &kp TILDE      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                             &trans                               &trans         &trans                    &trans         &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans                  &trans              &trans           &trans               &trans  &trans
&trans  &none   &none   &none   &none   &none                      &mt RG(PLUS) RG(MINUS)  &kp RC(RS(TAB))     &msc MOVE_Y(10)  &kp RC(TAB)          &trans  &trans
&trans  &none   &none   &none   &none   &none   &trans  &trans     &mt RC(RS(Z)) RC(Z)     &mkp LCLK           &mkp MCLK        &mkp RCLK            &trans  &trans
&trans  &none   &none   &none   &none   &none   &trans  &kp RC(T)  &kp RC(W)               &kp RA(LEFT_ARROW)  &msc MOVE_X(10)  &kp RA(RIGHT_ARROW)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RC(C)  &mt RG(V) RC(V)         &trans              &trans           &trans               &trans  &trans
            >;
        };

        SHORTCUT {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                           &trans       &trans              &trans              &trans                   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                           &trans       &kp LC(LG(LEFT))    &kp RG(UP_ARROW)    &kp RC(RG(RIGHT_ARROW))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans       &kp RG(LEFT_ARROW)  &kp RG(TAB)         &kp RG(RIGHT)            &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans       &kp LG(LC(LEFT))    &kp RG(DOWN_ARROW)  &kp LG(LC(RIGHT_ARROW))  &trans  &trans
&trans  &none   &trans  &trans  &trans  &trans  &trans  &kp RC(RS(TAB))  &kp RC(TAB)  &trans              &trans              &trans                   &trans  &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &trans
            >;
        };
    };
};
